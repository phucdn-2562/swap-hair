<file path="hairstyle/hairstyle.service.ts">
  1: import { GoogleGenerativeAI } from '@google/generative-ai';
  2: import {
  3:   BadGatewayException,
  4:   Injectable,
  5:   InternalServerErrorException,
  6:   Logger,
  7:   ServiceUnavailableException,
  8: } from '@nestjs/common';
  9: import type { Express } from 'express';
 10: 
 11: const DEFAULT_IMAGE_MODEL = 'gemini-2.5-flash-image';
 12: 
 13: export type HairstyleTryOnResult = {
 14:   model: string;
 15:   mimeType: string;
 16:   fileName: string;
 17:   buffer: Buffer;
 18: };
 19: 
 20: @Injectable()
 21: export class HairstyleService {
 22:   private readonly logger = new Logger(HairstyleService.name);
 23: 
 24:   async tryOn(
 25:     sourceImage: Express.Multer.File,
 26:     referenceImage: Express.Multer.File,
 27:   ): Promise<HairstyleTryOnResult> {
 28:     const apiKey = process.env.GEMINI_API_KEY;
 29:     if (!apiKey) {
 30:       throw new ServiceUnavailableException(
 31:         'GEMINI_API_KEY is missing. Configure it in your .env file.',
 32:       );
 33:     }
 34: 
 35:     const modelName =
 36:       process.env.GEMINI_IMAGE_MODEL || DEFAULT_IMAGE_MODEL;
 37: 
 38:     try {
 39:       const genAI = new GoogleGenerativeAI(apiKey);
 40:       const model = genAI.getGenerativeModel({
 41:         model: modelName,
 42:         // The installed @google/generative-ai type definition may not include
 43:         // responseModalities, while the Gemini API accepts it at runtime.
 44:         generationConfig: {
 45:           responseModalities: ['IMAGE', 'TEXT'],
 46:         } as any,
 47:       });
 48: 
 49:       // Explicit role mapping:
 50:       // Image 1 is the identity/target image.
 51:       // Image 2 is only the hairstyle reference.
 52:       const prompt = `
 53: Perform a photorealistic hairstyle transfer.
 54: 
 55: INPUT IMAGE ROLES:
 56: - IMAGE 1 is the original person and the target image to edit.
 57: - IMAGE 2 is a hairstyle reference only.
 58: 
 59: REQUIRED OUTPUT:
 60: Create one complete, realistic portrait of the person from IMAGE 1,
 61: with the hairstyle from IMAGE 2 applied to them.
 62: The final result must be IMAGE 1's person/face + IMAGE 2's hairstyle.
 63: 
 64: PRESERVE IMAGE 1:
 65: - Keep the identity and facial appearance of IMAGE 1.
 66: - Preserve eyes, eyebrows, nose, lips, jawline, cheeks, ears, skin tone,
 67:   expression, makeup and apparent age.
 68: - Preserve the original pose, camera angle, crop, framing, clothing,
 69:   accessories, background and lighting.
 70: - Do not copy or blend the face, identity, skin or makeup from IMAGE 2.
 71: 
 72: TRANSFER ONLY THE HAIR FROM IMAGE 2:
 73: - Match its haircut, length, silhouette, layers, fringe/bangs, parting,
 74:   volume, texture and hair color as closely as possible.
 75: - Adapt the hairstyle naturally to the head and hairline of IMAGE 1.
 76: - Create realistic hair strands, hairline, shadows and highlights.
 77: 
 78: IMAGE COMPLETENESS:
 79: - Return a complete full-frame portrait, not a close-up of the hair.
 80: - Keep the entire face visible, including forehead, eyes, nose, mouth and chin.
 81: - Do not crop, zoom, stretch, split, collage or create a before/after layout.
 82: - Do not leave blank, gray, white, transparent or unfinished areas.
 83: - Fill the full output canvas with the edited photograph.
 84: 
 85: Return exactly one finished edited image. Do not return explanatory text.
 86:       `.trim();
 87: 
 88:       const result = await model.generateContent([
 89:         {
 90:           inlineData: {
 91:             data: sourceImage.buffer.toString('base64'),
 92:             mimeType: sourceImage.mimetype,
 93:           },
 94:         },
 95:         {
 96:           inlineData: {
 97:             data: referenceImage.buffer.toString('base64'),
 98:             mimeType: referenceImage.mimetype,
 99:           },
100:         },
101:         { text: prompt },
102:       ]);
103: 
104:       const candidate = result.response.candidates?.[0];
105:       const parts = candidate?.content?.parts ?? [];
106:       const imagePart = parts.find(
107:         (part) => Boolean(part.inlineData?.data),
108:       );
109: 
110:       if (!imagePart?.inlineData?.data) {
111:         const modelText = parts
112:           .map((part) => part.text)
113:           .filter(Boolean)
114:           .join('\n');
115: 
116:         this.logger.warn(
117:           `Gemini returned no image. model=${modelName}, finishReason=${candidate?.finishReason || 'unknown'}, response=${modelText.slice(0, 500)}`,
118:         );
119: 
120:         throw new BadGatewayException(
121:           'Gemini did not return an image. Check the model response and try again.',
122:         );
123:       }
124: 
125:       const mimeType = imagePart.inlineData.mimeType || 'image/png';
126:       if (!mimeType.startsWith('image/')) {
127:         throw new BadGatewayException(
128:           `Gemini returned an unsupported MIME type: ${mimeType}`,
129:         );
130:       }
131: 
132:       const buffer = Buffer.from(imagePart.inlineData.data, 'base64');
133:       if (!buffer.length) {
134:         throw new BadGatewayException('Gemini returned an empty image.');
135:       }
136: 
137:       const extension = this.getFileExtension(mimeType);
138: 
139:       this.logger.log(
140:         `Gemini image generated. model=${modelName}, mimeType=${mimeType}, bytes=${buffer.length}`,
141:       );
142: 
143:       return {
144:         model: modelName,
145:         mimeType,
146:         fileName: `hairstyle-result.${extension}`,
147:         buffer,
148:       };
149:     } catch (error) {
150:       if (
151:         error instanceof BadGatewayException ||
152:         error instanceof ServiceUnavailableException
153:       ) {
154:         throw error;
155:       }
156: 
157:       const message = error instanceof Error ? error.message : String(error);
158:       this.logger.error(
159:         `Gemini hairstyle generation failed. model=${modelName}; ${message}`,
160:         error instanceof Error ? error.stack : undefined,
161:       );
162: 
163:       if (/429|quota|rate.?limit/i.test(message)) {
164:         throw new ServiceUnavailableException(
165:           'Gemini rate limit or quota exceeded. Please try again later.',
166:         );
167:       }
168: 
169:       throw new InternalServerErrorException(
170:         'Failed to generate hairstyle image with Gemini.',
171:       );
172:     }
173:   }
174: 
175:   private getFileExtension(mimeType: string): string {
176:     switch (mimeType) {
177:       case 'image/jpeg':
178:         return 'jpg';
179:       case 'image/webp':
180:         return 'webp';
181:       case 'image/png':
182:       default:
183:         return 'png';
184:     }
185:   }
186: }
