  1: import {
  2:   BadRequestException,
  3:   Controller,
  4:   HttpStatus,
  5:   Logger,
  6:   Post,
  7:   Res,
  8:   StreamableFile,
  9:   UploadedFiles,
 10:   UseInterceptors,
 11: } from '@nestjs/common';
 12: import { FileFieldsInterceptor } from '@nestjs/platform-express';
 13: import type { Response } from 'express';
 14: import type { HairstyleTryOnResult } from './hairstyle.service';
 15: import { HairstyleService } from './hairstyle.service';
 16: 
 17: type HairstyleUploadFiles = {
 18:   sourceImage?: Express.Multer.File[];
 19:   referenceImage?: Express.Multer.File[];
 20: };
 21: 
 22: const MAX_IMAGE_SIZE =
 23:   Math.max(1, Number(process.env.MAX_IMAGE_SIZE_MB || 10)) * 1024 * 1024;
 24: 
 25: const ALLOWED_IMAGE_TYPES = new Set([
 26:   'image/jpeg',
 27:   'image/png',
 28:   'image/webp',
 29: ]);
 30: 
 31: @Controller('hairstyles')
 32: export class HairstyleController {
 33:   private readonly logger = new Logger(HairstyleController.name);
 34: 
 35:   constructor(private readonly hairstyleService: HairstyleService) {}
 36: 
 37:   /**
 38:    * POST /api/hairstyles/try-on
 39:    * Multipart fields:
 40:    * - sourceImage: original portrait/person to preserve
 41:    * - referenceImage: image whose hairstyle should be transferred
 42:    *
 43:    * No authentication is required in this standalone project.
 44:    */
 45:   @Post('try-on')
 46:   @UseInterceptors(
 47:     FileFieldsInterceptor(
 48:       [
 49:         { name: 'sourceImage', maxCount: 1 },
 50:         { name: 'referenceImage', maxCount: 1 },
 51:       ],
 52:       {
 53:         limits: {
 54:           fileSize: MAX_IMAGE_SIZE,
 55:           files: 2,
 56:         },
 57:       },
 58:     ),
 59:   )
 60:   async tryOnHairstyle(
 61:     @UploadedFiles() files: HairstyleUploadFiles,
 62:     @Res({ passthrough: true }) response: Response,
 63:   ): Promise<StreamableFile> {
 64:     const sourceImage = files?.sourceImage?.[0];
 65:     const referenceImage = files?.referenceImage?.[0];
 66: 
 67:     if (!sourceImage || !referenceImage) {
 68:       throw new BadRequestException(
 69:         'Both sourceImage and referenceImage are required.',
 70:       );
 71:     }
 72: 
 73:     for (const file of [sourceImage, referenceImage]) {
 74:       if (!ALLOWED_IMAGE_TYPES.has(file.mimetype)) {
 75:         throw new BadRequestException(
 76:           'Only JPEG, PNG and WebP images are supported.',
 77:         );
 78:       }
 79: 
 80:       if (!file.buffer?.length || file.size > MAX_IMAGE_SIZE) {
 81:         throw new BadRequestException(
 82:           `Each image must be smaller than ${Math.floor(MAX_IMAGE_SIZE / 1024 / 1024)} MB.`,
 83:         );
 84:       }
 85:     }
 86: 
 87:     this.logger.log(
 88:       `Try-on request: source=${sourceImage.size} bytes, reference=${referenceImage.size} bytes`,
 89:     );
 90: 
 91:     const result: HairstyleTryOnResult =
 92:       await this.hairstyleService.tryOn(sourceImage, referenceImage);
 93: 
 94:     response.setHeader('Content-Type', result.mimeType);
 95:     response.setHeader(
 96:       'Content-Disposition',
 97:       `inline; filename="${result.fileName}"`,
 98:     );
 99:     response.setHeader('Content-Length', String(result.buffer.length));
100:     response.setHeader('Cache-Control', 'no-store');
101:     response.setHeader('X-AI-Model', result.model);
102: 
103:     return new StreamableFile(result.buffer, {
104:       type: result.mimeType,
105:       disposition: `inline; filename="${result.fileName}"`,
106:       length: result.buffer.length,
107:     });
108:   }
109: }
